# Gradle
.gradle/
build/

# Local build caches / downloaded artifacts (not part of the source tree)
.cache/
.toolchain/
dist/

# Android Studio / IDE
.idea/
*.iml
local.properties

# Build outputs (compiled APKs are published on GitHub Releases, never committed)
*.apk
*.aab
*.ap_

# Signing material and secrets
*.jks
*.keystore
keystore.properties
google-services.json

# Logs and OS noise
*.log
.DS_Store
Thumbs.db

# Embedded opencode runtime: the binary is ~186 MB, far above git's 100 MB
# per-file limit. It ships inside the published APK, not in the repository.
# See README ("Build from source") for how to restore it.
app/src/main/jniLibs/arm64-v8a/libopencode2_bin.so
app/src/main/runtime-v1-backup/

# Termux packages bundled as assets (~170 MB of .deb). They ship inside the
# published APK; the script that fetches them is in the README.
app/src/main/assets/toolbox/

# Offline SDK/Gradle/cache bundle (~300 MB). Generated by
# scripts/make-toolchain.py and shipped inside the APK.
app/src/main/assets/toolchain/
